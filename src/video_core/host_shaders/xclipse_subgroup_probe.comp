#version 450
#extension GL_KHR_shader_subgroup_basic : require

// A 64-lane workgroup validates required Wave32/Wave64 behavior by checking both
// gl_SubgroupSize and the number of subgroup-elected lanes after a real dispatch.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) buffer ProbeOutput {
    uint subgroup_size;
    uint elected_subgroups;
    uint invocation_count;
    uint reserved;
} output_data;

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        output_data.subgroup_size = gl_SubgroupSize;
    }
    if (subgroupElect()) {
        atomicAdd(output_data.elected_subgroups, 1u);
    }
    atomicAdd(output_data.invocation_count, 1u);
}
