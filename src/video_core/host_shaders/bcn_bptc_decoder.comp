const int bc7_nsub[8]  = int[](3,2,3,2,1,1,1,2);
const int bc7_npb[8]   = int[](4,6,6,6,0,0,0,6);
const int bc7_rot[8]   = int[](0,0,0,0,1,1,0,0);
const int bc7_isel[8]  = int[](0,0,0,0,1,0,0,0);
const int bc7_cbits[8] = int[](4,6,5,7,5,7,7,5);
const int bc7_abits[8] = int[](0,0,0,0,6,8,7,5);
const int bc7_epb[8]   = int[](1,0,0,1,0,0,1,1);
const int bc7_spb[8]   = int[](0,1,0,0,0,0,0,0);
const int bc7_ib[8]    = int[](3,3,2,2,2,2,4,2);
const int bc7_ib2[8]   = int[](0,0,0,0,3,2,0,0);

uint swizzle_offset(uvec2 pos) {
    return ((pos.x & 32u) << 3u) |
           ((pos.y & 6u) << 5u) |
           ((pos.x & 16u) << 1u) |
           ((pos.y & 1u) << 4u) |
           (pos.x & 15u);
}

uint bc_bits(uvec4 blk, int off, int n) {
    if (n <= 0) {
        return 0u;
    }
    int w = off >> 5;
    int s = off & 31;
    uint v = blk[w] >> uint(s);
    if (s != 0 && w < 3) {
        v |= blk[w + 1] << uint(32 - s);
    }
    return n >= 32 ? v : (v & ((1u << uint(n)) - 1u));
}

int bc_sign_extend(int v, int bits) {
    int m = 1 << (bits - 1);
    return (v ^ m) - m;
}

bool bc_is_anchor(int n_subsets, int part, int texel) {
    if (texel == 0) {
        return true;
    }
    if (n_subsets == 2) {
        return bc_anchor2[part] == texel;
    }
    if (n_subsets == 3) {
        return bc_anchor3b[part] == texel || bc_anchor3c[part] == texel;
    }
    return false;
}

int bc_anchors_before(int n_subsets, int part, int texel) {
    if (texel == 0) {
        return 0;
    }
    int count = 1;
    if (n_subsets == 2) {
        if (texel > bc_anchor2[part]) {
            count++;
        }
    } else if (n_subsets == 3) {
        if (texel > bc_anchor3b[part]) {
            count++;
        }
        if (texel > bc_anchor3c[part]) {
            count++;
        }
    }
    return count;
}

int bc_interpolate(int a, int b, int index, int index_bits) {
    int base = index_bits == 2 ? 0 : (index_bits == 3 ? 4 : 12);
    int w = bc_weights[base + index];
    return (a * (64 - w) + b * w + 32) >> 6;
}

int bc_expand(int v, int bits) {
    return (v << (8 - bits)) | (v >> (2 * bits - 8));
}

void bc7_decode_block(uvec4 blk, out vec4 out_texels[16]) {
    int mode = -1;
    for (int i = 0; i < 8; i++) {
        if (bc_bits(blk, i, 1) != 0u) {
            mode = i;
            break;
        }
    }
    if (mode < 0) {
        for (int t = 0; t < 16; t++) {
            out_texels[t] = vec4(0.0);
        }
        return;
    }

    int bit = mode + 1;
    int nsub = bc7_nsub[mode];
    int part = int(bc_bits(blk, bit, bc7_npb[mode]));
    bit += bc7_npb[mode];

    uint subsets = nsub == 2 ? bc_part2[part] : (nsub == 3 ? bc_part3[part] : 0u);

    int rotation = 0;
    if (bc7_rot[mode] != 0) {
        rotation = int(bc_bits(blk, bit, 2));
        bit += 2;
    }
    int isel = 0;
    if (bc7_isel[mode] != 0) {
        isel = int(bc_bits(blk, bit, 1));
        bit += 1;
    }

    ivec4 ep[6];
    int cbits = bc7_cbits[mode];
    int abits = bc7_abits[mode];

    for (int component = 0; component < 3; component++) {
        for (int subset = 0; subset < nsub; subset++) {
            for (int endpoint = 0; endpoint < 2; endpoint++) {
                ep[subset * 2 + endpoint][component] = int(bc_bits(blk, bit, cbits));
                bit += cbits;
            }
        }
    }

    int ncomp = 3;
    if (abits > 0) {
        for (int subset = 0; subset < nsub; subset++) {
            for (int endpoint = 0; endpoint < 2; endpoint++) {
                ep[subset * 2 + endpoint][3] = int(bc_bits(blk, bit, abits));
                bit += abits;
            }
        }
        ncomp = 4;
    } else {
        for (int subset = 0; subset < nsub; subset++) {
            for (int endpoint = 0; endpoint < 2; endpoint++) {
                ep[subset * 2 + endpoint][3] = 255;
            }
        }
    }

    if (bc7_epb[mode] != 0) {
        for (int subset = 0; subset < nsub; subset++) {
            for (int endpoint = 0; endpoint < 2; endpoint++) {
                int p = int(bc_bits(blk, bit, 1));
                bit += 1;
                for (int component = 0; component < ncomp; component++) {
                    ep[subset * 2 + endpoint][component] =
                        (ep[subset * 2 + endpoint][component] << 1) | p;
                }
            }
        }
    } else if (bc7_spb[mode] != 0) {
        for (int subset = 0; subset < nsub; subset++) {
            int p = int(bc_bits(blk, bit, 1));
            bit += 1;
            for (int endpoint = 0; endpoint < 2; endpoint++) {
                for (int component = 0; component < ncomp; component++) {
                    ep[subset * 2 + endpoint][component] =
                        (ep[subset * 2 + endpoint][component] << 1) | p;
                }
            }
        }
    }

    int extra = bc7_epb[mode] + bc7_spb[mode];
    for (int subset = 0; subset < nsub; subset++) {
        for (int endpoint = 0; endpoint < 2; endpoint++) {
            for (int component = 0; component < 3; component++) {
                ep[subset * 2 + endpoint][component] =
                    bc_expand(ep[subset * 2 + endpoint][component], cbits + extra);
            }
            if (abits > 0) {
                ep[subset * 2 + endpoint][3] =
                    bc_expand(ep[subset * 2 + endpoint][3], abits + extra);
            }
        }
    }

    int ib = bc7_ib[mode];
    int ib2 = bc7_ib2[mode];
    int bit_base = bit;

    for (int texel = 0; texel < 16; texel++) {
        int anchors = bc_anchors_before(nsub, part, texel);
        int sec_bit = bit_base + 16 * ib - nsub + ib2 * texel - anchors;
        int tbit = bit_base + ib * texel - anchors;
        int sub = int((subsets >> (texel * 2)) & 3u);
        bool anchor = bc_is_anchor(nsub, part, texel);

        int idx0 = int(bc_bits(blk, tbit, ib - (anchor ? 1 : 0)));
        int idx1 = ib2 != 0 ? int(bc_bits(blk, sec_bit, ib2 - (anchor ? 1 : 0))) : 0;

        int cidx = isel != 0 ? idx1 : idx0;
        int cib = isel != 0 ? ib2 : ib;
        ivec4 epa = ep[sub * 2];
        ivec4 epb = ep[sub * 2 + 1];

        ivec4 res;
        for (int component = 0; component < 3; component++) {
            res[component] = bc_interpolate(epa[component], epb[component], cidx, cib);
        }

        int aidx;
        int aib;
        if (ib2 != 0 && isel == 0) {
            aidx = idx1;
            aib = ib2;
        } else {
            aidx = idx0;
            aib = ib;
        }
        res[3] = bc_interpolate(epa[3], epb[3], aidx, aib);

        if (rotation != 0) {
            int tmp = res[rotation - 1];
            res[rotation - 1] = res[3];
            res[3] = tmp;
        }
        out_texels[texel] = vec4(res) / 255.0;
    }
}

int bc6_unq_unsigned(int v, int bits) {
    if (bits >= 15) return v;
    if (v == 0) return 0;
    if (v == (1 << bits) - 1) return 0xffff;
    return ((v << 15) + 0x4000) >> (bits - 1);
}

int bc6_unq_signed(int v, int bits) {
    if (bits >= 16) return v;
    if (v == 0) return 0;
    bool neg = v < 0;
    if (neg) v = -v;
    if (v >= (1 << (bits - 1)) - 1) {
        v = 0x7fff;
    } else {
        v = ((v << 15) + 0x4000) >> (bits - 1);
    }
    return neg ? -v : v;
}

void bc6h_decode_block(uvec4 blk, bool is_signed, out vec4 out_texels[16]) {
    int mode;
    int bit;
    if (bc_bits(blk, 1, 1) != 0u) {
        mode = int(((bc_bits(blk, 0, 8) >> 1) & 0xeu) | bc_bits(blk, 0, 1)) + 2;
        bit = 5;
    } else {
        mode = int(bc_bits(blk, 0, 2));
        bit = 2;
    }

    if ((bc6_flags[mode] & 1) != 0) {
        for (int t = 0; t < 16; t++) {
            out_texels[t] = vec4(0.0, 0.0, 0.0, 1.0);
        }
        return;
    }

    int neb = bc6_neb[mode];
    int nib = bc6_nib[mode];
    int npb = bc6_npb[mode];
    int nend = npb != 0 ? 4 : 2;

    ivec4 ep[4];
    for (int endpoint = 0; endpoint < 4; endpoint++) {
        ep[endpoint] = ivec4(0);
    }

    for (int field = bc6_foff[mode]; field < bc6_foff[mode + 1]; field++) {
        uint fd = bc6_fields[field];
        int fep = int(fd & 3u);
        int fc = int((fd >> 2) & 3u);
        int foff = int((fd >> 4) & 15u);
        int fnb = int((fd >> 8) & 31u);
        bool rev = ((fd >> 13) & 1u) != 0u;

        int v = int(bc_bits(blk, bit, fnb));
        bit += fnb;
        if (rev) {
            if (fnb > 0) {
                ep[fep][fc] |= int((bitfieldReverse(uint(v)) >> uint(32 - fnb)) << uint(foff));
            }
        } else {
            ep[fep][fc] |= v << foff;
        }
    }

    if ((bc6_flags[mode] & 2) != 0) {
        int delta_bits[3] = int[](bc6_d0[mode], bc6_d1[mode], bc6_d2[mode]);
        for (int endpoint = 1; endpoint < nend; endpoint++) {
            for (int component = 0; component < 3; component++) {
                int v = bc_sign_extend(ep[endpoint][component], delta_bits[component]);
                ep[endpoint][component] =
                    (ep[0][component] + v) & ((1 << neb) - 1);
            }
        }
    }

    for (int endpoint = 0; endpoint < nend; endpoint++) {
        for (int component = 0; component < 3; component++) {
            if (is_signed) {
                ep[endpoint][component] =
                    bc6_unq_signed(bc_sign_extend(ep[endpoint][component], neb), neb);
            } else {
                ep[endpoint][component] = bc6_unq_unsigned(ep[endpoint][component], neb);
            }
        }
    }

    int part = 0;
    int nsub = 1;
    uint subsets = 0u;
    if (npb != 0) {
        part = int(bc_bits(blk, bit, npb));
        bit += npb;
        subsets = bc_part2[part];
        nsub = 2;
    }

    int bit_base = bit;
    for (int texel = 0; texel < 16; texel++) {
        int anchors = bc_anchors_before(nsub, part, texel);
        int tbit = bit_base + nib * texel - anchors;
        int sub = int((subsets >> (texel * 2)) & 3u);
        int index = int(
            bc_bits(blk, tbit, nib - (bc_is_anchor(nsub, part, texel) ? 1 : 0)));

        ivec4 epa = ep[sub * 2];
        ivec4 epb = ep[sub * 2 + 1];
        vec4 res = vec4(0.0, 0.0, 0.0, 1.0);

        for (int component = 0; component < 3; component++) {
            int v = bc_interpolate(epa[component], epb[component], index, nib);
            if (is_signed) {
                v = v < 0 ? int(uint(-v * 31 / 32) | 0x8000u) : (v * 31 / 32);
            } else {
                v = v * 31 / 64;
            }
            res[component] = unpackHalf2x16(uint(v) & 0xffffu).x;
        }
        out_texels[texel] = res;
    }
}

void main() {
    const ivec3 output_size = imageSize(dest_image);
    const uvec3 block_coord = gl_GlobalInvocationID;
    const uvec2 texel_origin = block_coord.xy * 4u;

    if (texel_origin.x >= uint(output_size.x) ||
        texel_origin.y >= uint(output_size.y) ||
        block_coord.z >= uint(output_size.z)) {
        return;
    }

    // BC6H/BC7 are always 16 bytes per 4x4 block.
    uvec3 pos = block_coord;
    pos.x <<= 4u;

    uint offset = block_coord.z * pc.layer_stride;
    uint block_y = pos.y >> GOB_SIZE_Y_SHIFT;
    offset += (block_y >> pc.block_height) * pc.block_size;
    offset += (block_y & pc.block_height_mask) << GOB_SIZE_SHIFT;
    offset += (pos.x >> GOB_SIZE_X_SHIFT) << pc.x_shift;
    offset += swizzle_offset(pos.xy);

    uint word_offset = offset >> 2u;
    uvec4 block = uvec4(
        input_buffer.data[word_offset],
        input_buffer.data[word_offset + 1u],
        input_buffer.data[word_offset + 2u],
        input_buffer.data[word_offset + 3u]);

    vec4 texels[16];
    if (pc.format == 4u) {
        bc6h_decode_block(block, false, texels);
    } else if (pc.format == 5u) {
        bc6h_decode_block(block, true, texels);
    } else {
        bc7_decode_block(block, texels);
    }

    for (uint texel = 0u; texel < 16u; ++texel) {
        uint x = texel_origin.x + (texel & 3u);
        uint y = texel_origin.y + (texel >> 2u);
        if (x < uint(output_size.x) && y < uint(output_size.y)) {
            imageStore(dest_image,
                       ivec3(int(x), int(y), int(block_coord.z)),
                       texels[texel]);
        }
    }
}
