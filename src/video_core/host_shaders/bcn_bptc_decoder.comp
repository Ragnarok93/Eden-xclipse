#version 450

// Xclipse BPTC decoder.
//
// Decoder tables and BC6H/BC7 block algorithms are adapted from RADV-Xclipse's
// MIT-licensed bc_decoder.glsl, which in turn follows Mesa's BPTC CPU decoders.
// Eden replaces RADV's compressed-image source plane with a direct Tegra
// block-linear storage-buffer read, fusing guest unswizzle and decode.
//
// One invocation decodes one complete 4x4 compressed block. This avoids the
// repeated mode/endpoint parsing of one-invocation-per-output-pixel decoders.
//
// format:
//   4 = BC6H_UFLOAT
//   5 = BC6H_SFLOAT
//   6 = BC7 (UNORM or SRGB guest semantic; destination storage view is UNORM)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint format;
    uint layer_stride;
    uint block_size;
    uint x_shift;
    uint block_height;
    uint block_height_mask;
} pc;

layout(binding = 0, std430) readonly restrict buffer InputBufferU32 {
    uint data[];
} input_buffer;

#ifndef BPTC_DST_FORMAT
#define BPTC_DST_FORMAT rgba8
#endif

layout(binding = 1, BPTC_DST_FORMAT) uniform writeonly restrict image2DArray dest_image;

const uint GOB_SIZE_X_SHIFT = 6u;
const uint GOB_SIZE_Y_SHIFT = 3u;
const uint GOB_SIZE_SHIFT = GOB_SIZE_X_SHIFT + GOB_SIZE_Y_SHIFT;

